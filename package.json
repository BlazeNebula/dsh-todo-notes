{
  "name": "dsh-todo-notes",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "heshujiang",
  "description": "TODO 便签：用户级 / 工作区级 / 会话级三区待办面板，支持文件夹多引用、优先级、批量整理与 DSH 审批下的 Agent 读写工具。",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlazeNebula/dsh-todo-notes"
  },
  "homepage": "https://github.com/BlazeNebula/dsh-todo-notes#readme",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "todo",
    "notes",
    "便签",
    "待办"
  ],
  "dsh": {
    "category": "extension",
    "displayName": "TODO 便签",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check": "node --check lib/index.js && node --check lib/core/paths.js && node --check lib/core/text.js && node --check lib/core/groups.js && node --check lib/core/write.js && node --check lib/core/http.js && node --check lib/core/tools.js && node --check client/client.js"
  },
  "files": [
    "lib",
    "client",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg",
    "scripts"
  ]
}
